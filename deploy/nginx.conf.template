# Include in nginx's http {} context (for example /etc/nginx/conf.d/dyu.conf).
# Replace every STOREFRONT_HOST with the permanent hostname, without scheme/port.
# Direct-to-Nginx HTTPS topology only; see docs/deployment.md before adding a CDN.

map $request_method $dyu_mutation_key {
    default $binary_remote_addr;
    GET "";
    HEAD "";
    OPTIONS "";
}
map $uri $dyu_route {
    default storefront;
    ~^/_next/ asset;
    ~^/api/auth/ auth;
    ~^/api/account account;
    /api/cart cart;
    /api/checkout checkout;
    /api/health health;
    /api/revalidate revalidate;
}
# No raw paths, queries, IP addresses, referrers, headers or bodies in access logs.
log_format dyu_safe escape=json '{"time":"$time_iso8601","method":"$request_method","route":"$dyu_route","status":$status,"bytes":$body_bytes_sent,"duration":$request_time}';
limit_req_zone $binary_remote_addr zone=dyu_pages:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=dyu_api:10m rate=6r/s;
limit_req_zone $dyu_mutation_key zone=dyu_writes:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=dyu_auth:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=dyu_webhooks:10m rate=10r/s;

server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/dyu-access.log dyu_safe;
    error_log /dev/null;
    return 444;
}
server {
    listen 80;
    server_name STOREFRONT_HOST;
    access_log /var/log/nginx/dyu-access.log dyu_safe;
    error_log /dev/null;
    return 308 https://STOREFRONT_HOST$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    large_client_header_buffers 4 16k;
    access_log /var/log/nginx/dyu-access.log dyu_safe;
    error_log /dev/null;
}
server {
    listen 443 ssl;
    server_name STOREFRONT_HOST;
    ssl_certificate /etc/dyu/tls/fullchain.pem;
    ssl_certificate_key /etc/dyu/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != STOREFRONT_HOST) { return 444; }

    access_log /var/log/nginx/dyu-access.log dyu_safe;
    # Nginx error messages can include callback queries. Use safe access metrics
    # and bounded application diagnostics; do not enable raw request error logs.
    error_log /dev/null;
    server_tokens off;
    client_max_body_size 20000;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 30s;
    large_client_header_buffers 4 16k;
    limit_req_status 429;

    proxy_http_version 1.1;
    proxy_set_header Host STOREFRONT_HOST;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header Forwarded "";
    proxy_set_header CF-Connecting-IP "";
    proxy_cache off;
    proxy_buffering off;
    proxy_request_buffering on;
    # Encrypted session cookies can span several Set-Cookie headers.
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 30s;
    # Never replay an ambiguous write on another upstream.
    proxy_next_upstream off;

    location = /api/revalidate {
        client_max_body_size 4m;
        limit_req zone=dyu_webhooks burst=100 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location ^~ /api/auth/ {
        limit_req zone=dyu_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location /api/ {
        limit_req zone=dyu_api burst=30 nodelay;
        limit_req zone=dyu_writes burst=15 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
    }
    location / {
        limit_req zone=dyu_pages burst=100 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
}
