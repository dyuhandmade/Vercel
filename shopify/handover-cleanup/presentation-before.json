            "image": null,
            "products": {
              "nodes": [
                {
                  "id": "gid://shopify/Product/8903888994523",
                  "handle": "damask-rose-cold-processed-soap",
                  "title": "Damask Rose Cold Processed Soap",
                  "descriptionHtml": "<h2 class=\"a-size-base-plus a-text-bold\"></h2>\n<ul class=\"a-unordered-list a-vertical a-spacing-mini\">\n<li class=\"a-spacing-mini\"><span class=\"a-list-item\">Infused with saponified extra Virgin- coconut oil, this handmade soap deeply cleanses while maintaining natural skin moisture, making it suitable for all skin types including sensitive skin. </span></li>\n<li class=\"a-spacing-mini\"><span class=\"a-list-item\">French pink clay gently detoxifies and exfoliates, removing dead skin cells and impurities while leaving your skin soft, radiant, and visibly smoother after regular use. </span></li>\n<li class=\"a-spacing-mini\"><span class=\"a-list-item\">Enriched with Rose Centifolia absolute oil, known for its calming fragrance and skin-conditioning properties, offering a spa-like floral experience during every bath or shower. </span></li>\n<li class=\"a-spacing-mini\"><span class=\"a-list-item\">Vitamin E supports skin repair and reduces signs of aging by providing antioxidant protection and aiding skin elasticity, helping you maintain youthful, nourished skin. </span></li>\n<li class=\"a-spacing-mini\"><span class=\"a-list-item\">The inclusion of Aqua and Damask Rose provides hydration and a luxurious feel, creating a lather that refreshes and uplifts, leaving a subtle rose scent on your skin all day.</span></li>\n</ul>",
                  "vendor": "My Store",
                  "productType": "Cold processed Soap",
                  "updatedAt": "2026-10-04T09:26:36Z",
                  "featuredMedia": {
                    "id": "gid://shopify/MediaImage/45202466668763",
