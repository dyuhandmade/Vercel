SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for local development, tunnels and staging. Enable only after launch approval.
SITE_INDEXING_ENABLED=false
# Explicitly enable illustrative fixtures only for development/design review.
DEMO_MODE=true

# Shopify Headless > Customer Account API (public client recommended).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2026-07
# Optional server-side canonical origin override (also useful for HTTPS previews).
CUSTOMER_ACCOUNT_SITE_URL=
# Only required if the configured Shopify client is confidential. Server-only.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Generate a cryptographically random secret, at least 32 bytes. Never commit it.
CUSTOMER_ACCOUNT_SESSION_SECRET=
# Optional hosted customer account portal override.
SHOPIFY_CUSTOMER_ACCOUNT_URL=
# Set only to a client-IP header overwritten by your trusted hosting proxy.
SHOPIFY_BUYER_IP_HEADER=
# Set if Shopify checkout uses your verified custom domain.
SHOPIFY_CHECKOUT_DOMAIN=

# Payments use Shopify's hosted checkout. Connect the official All-in-one Razorpay
# Payment Gateway in Shopify Settings > Payments. No Razorpay API keys belong here.
